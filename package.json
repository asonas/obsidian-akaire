{
  "name": "akaire",
  "version": "0.3.1",
  "description": "Local AI editor for Obsidian using Claude Code, Codex, or Ollama",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "stylelint styles.css && eslint src",
    "lint:css": "stylelint styles.css",
    "lint:ts": "eslint src"
  },
  "devDependencies": {
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "esbuild": "^0.24.0",
    "eslint": "^10.3.0",
    "eslint-plugin-obsidianmd": "^0.2.9",
    "obsidian": "1.12.3",
    "stylelint": "^17.11.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@textlint-rule/textlint-rule-no-invalid-control-character": "^3.0.0",
    "@textlint-rule/textlint-rule-no-unmatched-pair": "^2.0.4",
    "@textlint/kernel": "^15.8.0",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "@textlint/types": "^15.8.0",
    "textlint-rule-ja-no-mixed-period": "^3.0.2",
    "textlint-rule-max-comma": "^4.0.0",
    "textlint-rule-max-kanji-continuous-len": "^1.1.1",
    "textlint-rule-no-exclamation-question-mark": "^1.1.0",
    "textlint-rule-no-hankaku-kana": "^2.0.1",
    "textlint-rule-no-nfd": "^2.0.2",
    "textlint-rule-no-zero-width-spaces": "^1.0.1",
    "textlint-rule-sentence-length": "^5.2.1",
    "yaml": "^2.4.0"
  }
}
